<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_3d_detection</name>
  <version>0.1.0</version>
  <description>点云 3D 目标检测、跟踪与预测。</description>
  <maintainer email="junyong.mou@seres.cn">junyong.mou</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>perception_interface</depend>
  <!-- INSPVAX localization of the kygi665 robot; declared so that colcon builds it first -->
  <depend>kygi665_msgs</depend>
  <depend>glog</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
