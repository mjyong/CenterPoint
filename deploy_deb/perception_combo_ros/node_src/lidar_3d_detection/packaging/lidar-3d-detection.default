# Environment of lidar-3d-detection.service (start_lidar_3d_detection.sh). Kept on upgrades.
#ROS_DOMAIN_ID=0
# DDS: the same middleware and settings as the robot's other nodes, or they do not hear each other (README "DDS")
#RMW_IMPLEMENTATION=rmw_fastrtps_cpp
#RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
#CYCLONEDDS_URI=file:///opt/ros/cyclonedds.xml
# Fast DDS: 8 MB socket buffers, else ~3 MB clouds are lost (T33); the lidar driver needs them as well
#FASTRTPS_DEFAULT_PROFILES_FILE=@PREFIX@/lidar_3d_detection/share/lidar_3d_detection/fastdds_large_buffers.xml
LIDAR3D_THREADS=4
#LIDAR3D_CONFIG=@PREFIX@/lidar_3d_detection/config/lidar_3d_detection.yaml
#LIDAR3D_MODEL_DIR=@PREFIX@/lidar_3d_detection/model
#LIDAR3D_LOG_DIR=/tmp/lidar_3d_detection_logs
# a viewer (Foxglove, RViz) on this node: TF and the detector's input cloud; not with the vehicle's own TF tree
#LIDAR3D_ARGS=-p publish_tf:=true -p publish_cloud:=true
