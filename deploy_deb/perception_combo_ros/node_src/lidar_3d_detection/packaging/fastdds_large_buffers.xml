<?xml version="1.0" encoding="UTF-8" ?>
<!-- Fast DDS (rmw_fastrtps_cpp): 8 MB send / receive socket buffers for the ~3 MB lidar clouds, which go over UDP
     (larger than the shared memory segment). With the default buffers clouds are lost (T33 on the Orin: 341 of
     600 with unlocked clocks; 452 of 600 with locked clocks as soon as a second reader, foxglove_bridge,
     subscribes); with these, 592-597. Every process on the path needs it: the publisher (lidar driver, bag
     player), this node, and the viewer's bridge. The kernel caps it at net.core.rmem_max / wmem_max (16 MB on
     the Orin). Use it with FASTRTPS_DEFAULT_PROFILES_FILE=<this file> (README "DDS"); not with CycloneDDS. -->
<dds>
  <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <participant profile_name="large_buffers" is_default_profile="true">
      <rtps>
        <sendSocketBufferSize>8388608</sendSocketBufferSize>
        <listenSocketBufferSize>8388608</listenSocketBufferSize>
      </rtps>
    </participant>
  </profiles>
</dds>
