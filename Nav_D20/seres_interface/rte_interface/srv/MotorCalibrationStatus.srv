# 请求部分：
uint8 action
uint8 QUERY_ZERO_MACHINE_STATUS = 0
uint8 QUERY_SINGLE_MOTOR_STATUS = 1
uint8 QUERY_KP_THRESHOLD = 2
uint8 QUERY_KD_THRESHOLD = 3
uint8 QUERY_TORQUE_THRESHOLD = 4
uint8 QUERY_SINGLE_KP_THRESHOLD = 5
uint8 QUERY_SINGLE_KD_THRESHOLD = 6
uint8 QUERY_SINGLE_TORQUE_THRESHOLD = 7
uint8 motor_id
---
# 响应部分：
 # "true(success)" 或 "false(failure)"
bool status  
MotorCalibrationParam[] motor_status
#------------------------------     
# action
# 0: 查询整机标零（人形标识为上肢或者下肢，四肢：标识耳朵/头部/四足）
# 1：查询单电机标零（根据电机序号识别）
# 2：查询整机电机 kp 阈值
# 3：查询整机电机 kd 阈值
# 4：查询单电机 kp 阈值
# 5：查询单电机 kd 阈值
# motor_id
# 单电机查询时有效，表示电机序号
#-      
# status：
# 查询整机标零：true(已完成标零）或者未完成标零
#              motor_status：包含未标零的电机信息（已标零则不填写）
# 查询单电机标零：true(已完成标零）或者未完成标零，motor_status不填写
# 查询整机电机 kp 阈值：true(成功获取）或者失败，motor_status列表填写整机内容
# 查询整机电机 kd 阈值：true(成功获取）或者失败，motor_status列表填写整机内容
# 查询单电机 kp 阈值：true(成功获取）或者失败，motor_status列表填写单个内容
# 查询单电机 kd 阈值：true(成功获取）或者失败，motor_status列表填写单个内容