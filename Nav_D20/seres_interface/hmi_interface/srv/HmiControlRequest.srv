# 控制参数
# priority取值参考 common_interface/ResourcePriority.msg 中的 PRIORITY_*
common_interface/ResourcePriority  priority     # 业务优先级1，3，5，7
uint16 index                                    # 全局优先级
string effect                                   # 效果映射枚举
string sn_code                                  # sn码，只有在显示二维码场景时才需要填写，其他情况为空
string name                                     # 调用方名称（用于日志）
string request_id                               # 本次请求ID；空则服务端生成代表新增一个任务,非空则替换原有相同id任务信息
---
# Result                                        
bool  success                                   # 是否成功
string request_id                               # 回传请求ID（与 Request 中一致或由服务端生成）
string msg                                      # 成功或失败原因
int8 code                                       # 请求返回码，0代表请求成功，1代表请求成功但有高优先级的占用,2重复请求，3覆盖请求

