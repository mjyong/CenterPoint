#咖啡机统⾥的订单号
int32 order_id
---
int32 result_code           # 0请求成功,-1订单不存在
int32 order_id       #系统⾥的订单id
string name          #商品名称"
int32 status         #0未开始排队中1制作中2已完成（未取⾛）3已完成（已取⾛）4失败5主动取消
string makeice       #只有冰拿铁和冰美式,浓缩液有此选项（"none"不加冰,"little"加少量冰,"standard"加标准冰）
string sugar         #加糖选项（"none"不加糖,"1"加1号糖,"2"加2号糖,"3"加3号糖）
string sugarweight   #加糖的量（"little"少量糖,"standard"标准量糖,"much"多糖）
string fail_code     #如果订单失败，返回失败码。失败码
string start_time    #'2025-10-1016:15:00',开始时间
string end_time      #'2025-10-1016:17:55',完成时间
string takeaway_time #:'2025-10-1016:18:10',订单拿⾛时间

#失败码：
#2052: "因取杯失败,订单失败'
#2054: "因机械臂急停,订单失败'
#2055: "因程序故障,订单失败'
#2056: "因加冰失败,订单失败'
#2057: "因加糖失败,订单失败'
#2058: "因咖啡机状态异常,订单失败'
#2060: "因⼿臂压杯盖失败,订单失败'
#2061: "因不能满⾜⼝味要求,订单失败'
#2063: "因失败订单未处理，设备异常,订单失败'
#2064: "因设备硬件通讯状态异常，订单失败