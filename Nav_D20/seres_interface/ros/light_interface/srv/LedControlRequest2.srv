#灯控目标
# target = 0(氛围灯)
# target = 1(补光灯)
# target = 2(暖光灯)

common_interface/ResourcePriority priority #业务优先级1，3，5，7
uint16 index      #全局优先级
uint8  target     #操作目标,默认0表示氛围灯，1表示照明灯，2表示暖光灯 
string effect     #效果映射枚举  
string name       #请求者名字，用于debug
string request_id #请求id,如果有就用这个，没有会自己生成，如果请求时带有request_id则会覆盖之前请求的效果，可以用来修改当前状态

---
bool   success
string request_id
string msg
int8   code     #请求返回码，0代表请求成功，1代表请求成功但有高优先级的占用,2重复请求，3覆盖请求
