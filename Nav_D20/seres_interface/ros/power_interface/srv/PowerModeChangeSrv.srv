# Request
string requester_node_name      # Name of the requesting node (max 64 chars)
uint8 cmd                       # Target mode command

# Constants for cmd
uint8 CMD_SHUTDOWN   = 0        # Shut down the robot
uint8 CMD_SLEEP      = 1        # Enter sleep mode
uint8 CMD_WORK       = 2        # Enter work mode
uint8 CMD_EMERGENCY  = 3        # Emergency stop (cut off the power supply to the joint motor)
uint8 CMD_RESTART    = 4        # Restart the system
uint8 CMD_CHARGE_REQ = 5        # Auto Search for Charging Station and Charge
uint8 CMD_EMERGENCY_CANCLE = 6  # Cancel emergency stop (restore the power supply to the joint motor)
uint8 CMD_CHARGE_EXIT = 7       # Stop Charging

---
# Response
uint8 ret_code                  # Result of the operation
string message                  # Optional message, e.g., error description

# Return code constants
uint8 RET_SUCCESS     = 0       # Request accepted successfully
uint8 RET_TIMEOUT     = 1       # Request TimeOut
uint8 RET_ERROR       = 2       # Request rejected due to invalid parameters or system state