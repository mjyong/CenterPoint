# 单个控制对象的电源状态
uint8 target       # 控制对象
uint8 action       # 控制方式
uint16 extended    # 扩展字段

# ==========================
# target 字段说明:
# 0x00--系统本体所有电源管理
# 0x01--GPU电源
# 0x02--LTE上网模组的电源
# 0x03---SSD的电源
# 0x04---BT电源
# 0x05---WIFI电源
# 0x06---USB电源
# 0x07---HDMI电源
# 0x08---LED灯电源
# 0x09---风扇电源
# 0x0A---驱动电机总电源
# 0x0B---驱动电机各个通道的电源
# 0x0C---IMU电源
# 0x0D---导航GPS模块电源
# 0x0E----雷达模块电源
# 0x0F----充电使能开关

# ==========================
# action字段说明:
# 0x00--下电； 
# 0x01--上电； 
# 0x02--断电并重新上电（断电3s再上电）;
# 0x03--查询； 

# ==========================
# extended 字段说明:
# 扩展字段用于表示额外信息;
# target:0x0B（电机电源）时，extended表示为电机通道ID
# 通道ID定义：D10:4个通道，0-3分别表示：左前-右前-左后-右后
# R11-A3:6个通道，0头部，1左臂，2右臂，3腰部，4左腿，5右腿
# target:0x0E（雷达电源）时，extended 0表示all，1表示激光雷达，2表示超声波雷达；
# target:0x12（相机）时，extended 0表示all，1表示单目相机，2表示深度相机；
