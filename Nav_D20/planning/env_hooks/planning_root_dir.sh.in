export LD_LIBRARY_PATH="$PLANNING_ROOT_DIR/lib:/opt/seres/middleware/nav:/opt/seres/middleware/robot_common/lib:/opt/seres/middleware/robot_common/lib3:$LD_LIBRARY_PATH"
