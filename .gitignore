**__pycache__**
**build**
**egg-info**
**dist**
data/*
!data/survey/
!data/preview/
!data/examples/
!data/labels/
!data/reports/
!data/reports/**/build.txt
!data/reports/**/build_*.txt
*.pyc
venv/
*.idea/
*.so
*.yaml
!samples/**/metadata.yaml
!data/examples/**/metadata.yaml
!work_dirs/planning_io_t41/**/metadata.yaml
!work_dirs/planning_io_t42/**/metadata.yaml
!work_dirs/planning_io_t47_map/**/metadata.yaml
!work_dirs/planning_io_t47_ins/**/metadata.yaml
!work_dirs/planning_io_t48_map/**/metadata.yaml
!work_dirs/planning_io_t48_ins/**/metadata.yaml
!work_dirs/planning_io_t48_switch/**/metadata.yaml
!work_dirs/planning_io_t49_map/**/metadata.yaml
!work_dirs/planning_io_t49_ins/**/metadata.yaml
!work_dirs/planning_io_t49_switch/**/metadata.yaml
!work_dirs/planning_io_t50_map/**/metadata.yaml
!work_dirs/planning_io_t50_ins/**/metadata.yaml
!work_dirs/planning_io_t50_switch/**/metadata.yaml
*.sh
!data/reports/**/*.sh
*.pth
!work_dirs/pretrained/nusc_pp.pth
!work_dirs/pretrained/nusc_voxel.pth
*.pkl
!data/labels/**/*.pkl
# review.mcap is regenerated by tools/dog/review_labels.py from the labels
data/labels/**/*.mcap
!data/examples/**/*.pkl
*.zip
!Nav_D20/map/*.zip
*.bin
.vscode/
# vendored SUSTechPOINTS: keep its sources; scenes exported into its data/ stay local (its own .gitignore)
!third_party/SUSTechPOINTS/**/*.sh
!third_party/SUSTechPOINTS/data/
# deployment tools (docs/DEPLOY_ORIN.md): their scripts and the engine builder are sources; ONNX graphs and
# engines stay local
!tools/deploy/*.sh
!tools/deploy/build_engines.py
# the vehicle deployment tree (deploy_deb): its scripts and parameter files too; colcon's and build_deb.sh's
# outputs and the packages stay local
!deploy_deb/**/*.sh
!deploy_deb/**/scripts/build_deb.sh
!deploy_deb/**/*.yaml
deploy_deb/**/install/
deploy_deb/GIT_COMMIT
deploy_deb/**/log/
*.deb
*.onnx
*.engine
# Nav_D20 (the D20 planning stack, 2026-11-09): its launch scripts and configs are sources. The *.sh, *.yaml and
# **build** rules above, from upstream CenterPoint, had dropped every run script and config (the A* map's
# CJGC.yaml, the localization and perception settings, build.sh). Its colcon build directories stay out.
!Nav_D20/**/*.sh
!Nav_D20/**/*.yaml
